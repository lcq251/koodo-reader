  "principle": "《諸卦反對性情》（《杂卦传》改编）分句直引（繁体）。text 为原文整行，guas 为句中出现的卦名（标准名，变体归一：複→復、鹹→咸、遁→遯）。末句为总结无卦。卦名由字面子串提取，非语义臆造。",
  "lines": [
    {
      "line": 1308,
      "text": "乾剛坤柔反其義，比卦歡欣困憂慮。",
      "guas": [
        "乾",
        "坤",
        "比",
        "困"
      ]
    },
    {
      "line": 1309,
      "text": "臨逢百物觀求之，蒙卦難明屯不失。",
      "guas": [
        "屯",
        "蒙",
        "臨",
        "觀"
      ]
    },
    {
      "line": 1310,
      "text": "大畜其卦福之生，無妄若遇禍之始。",
      "guas": [
        "無妄",
        "大畜"
      ]
    },
    {
      "line": 1311,
      "text": "升者去而不復回，萃者聚而終不去。",
      "guas": [
        "萃",
        "升"
      ]
    },
    {
      "line": 1312,
      "text": "謙卦自尊豫怠人，震則動而艮則止。",
      "guas": [
        "謙",
        "豫",
        "震",
        "艮"
      ]
    },
    {
      "line": 1313,
      "text": "兌主外遇禍之藏，隨前坎後偷安矣。",
      "guas": [
        "隨",
        "坎",
        "兌"
      ]
    },
    {
      "line": 1314,
      "text": "剝體消爛複自生，蠱改前非而已矣。",
      "guas": [
        "蠱",
        "剝",
        "復"
      ]
    },
    {
      "line": 1315,
      "text": "明夷內朗又逢傷，晉主外明並通理。",
      "guas": [
        "明夷",
        "晉"
      ]
    },
    {
      "line": 1316,
      "text": "益擬茂盛損象衰，鹹速恒遲渙遠遁。",
      "guas": [
        "恒",
        "損",
        "益",
        "渙",
        "咸",
        "遯"
      ]
    },
    {
      "line": 1317,
      "text": "同人內親睽外疏，解卦從容蹇難啟。",
      "guas": [
        "同人",
        "睽",
        "蹇",
        "解"
      ]
    },
    {
      "line": 1318,
      "text": "離文美麗艮光明，遁退回身姤相遇。",
      "guas": [
        "離",
        "姤",
        "艮",
        "遯"
      ]
    },
    {
      "line": 1319,
      "text": "大有曰眾豐曰多，坎卦履險震卦起。",
      "guas": [
        "大有",
        "坎",
        "震",
        "豐"
      ]
    },
    {
      "line": 1320,
      "text": "需不進兮訟不寧，既濟一定無後慮。",
      "guas": [
        "既濟",
        "需",
        "訟"
      ]
    },
    {
      "line": 1321,
      "text": "未濟之卦男之終，歸妹之辭歸之始。",
      "guas": [
        "歸妹",
        "未濟"
      ]
    },
    {
      "line": 1322,
      "text": "否遭大往而小來，泰卦大來而小去。",
      "guas": [
        "泰",
        "否"
      ]
    },
    {
      "line": 1323,
      "text": "革去舊故鼎從新，小畜曰寡噬嗑食。",
      "guas": [
        "小畜",
        "噬嗑",
        "革",
        "鼎"
      ]
    },
    {
      "line": 1324,
      "text": "旅羈其外大過顛，夬卦分明曰快利。",
      "guas": [
        "大過",
        "夬",
        "旅"
      ]
    },
    {
      "line": 1325,
      "text": "要將字字考精詳，雜卦性情反對是。",
      "guas": []
    }
  ],
